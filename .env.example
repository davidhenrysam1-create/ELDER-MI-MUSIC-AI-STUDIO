# Elder Mi Music AI Studio — every setting the app understands.
#
#   cp .env.example .env.local     then edit .env.local
#
# `.env.local` is git-ignored and must NEVER be committed: it holds keys. Leave a
# value empty to disable that feature — the app reports "not configured" honestly
# rather than pretending.
#
# The four that matter most:
#   ADMIN_EMAIL / ADMIN_PASSWORD   the owner account (password is never in code)
#   SUPABASE_URL / SUPABASE_SECRET_KEY   durable storage; without them everything
#                                  lives on one machine's disk
#
# STUDIO_ACCOUNTS: empty = open studio (no sign-in screen, you are the owner).
#                  "on" = real logins. Use "on" on any PUBLIC address.
#
ADMIN_EMAIL=
ADMIN_PASSWORD=
ALLOW_SIGNUP=
DATABASE_DRIVER=
DATA_DIR=
ELEVENLABS_API_KEY=
ELEVENLABS_MUSIC_MODEL=
ELEVENLABS_USD_PER_SEC=
EMAIL_FROM=
GEMINI_MODEL=
GOOGLE_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_VERTEX_ACCESS_TOKEN=
GOOGLE_VERTEX_LOCATION=
GOOGLE_VERTEX_PROJECT=
LYRIA_MODEL=
LYRIA_USD_PER_SEC=
MAX_DURATION_SEC=
MAX_UPLOAD_MB=
NEXT_PUBLIC_SITE_URL=
REPLICATE_API_TOKEN=
REPLICATE_MUSICGEN_MODEL=
REPLICATE_MUSICGEN_USD_PER_SEC=
RESEND_API_KEY=
SPEND_CAP_USD=
STABILITY_API_KEY=
STABLE_AUDIO_USD_PER_SEC=
STORAGE_DRIVER=
STUDIO_ACCOUNTS=
STUDIO_PASSWORD=
STUDIO_USER=
SUPABASE_BUCKET=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_TABLE=
SUPABASE_URL=
VOICE_CONVERSION_API_URL=
