# ---------------------------------------------------------------------------
# Elder Mi Music AI Studio — environment configuration
# Copy to .env.local (never commit real secrets).
# ---------------------------------------------------------------------------

# Optional: enables "Improve My Prompt" and AI mixing stages via Gemini.
# When empty, a deterministic local production rule engine is used and clearly
# labelled "local-heuristic" in the UI.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional: the public URL the studio is served from (used for metadata/PWA).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: where the private JSON index and audio files live.
# Deployments need a persistent volume mounted here.
DATA_DIR=./.data

# Optional: default upload limits (can also be edited in Settings).
MAX_UPLOAD_MB=80
MAX_DURATION_SEC=720

# Optional: protect the whole studio with HTTP Basic auth (pages + API).
# This is an extra door in front of the account system below, not a replacement.
# Leave empty for a local studio. Use a long random password if exposed.
STUDIO_PASSWORD=
STUDIO_USER=studio

# ---------------------------------------------------------------------------
# Accounts
# ---------------------------------------------------------------------------
# OPEN STUDIO (default): leave STUDIO_ACCOUNTS unset and the app opens straight
# into the studio. There is no login screen; every request acts as the owner
# account (ADMIN_EMAIL, created automatically with all roles), so publishing,
# likes, follows, downloads and /admin all work immediately.
#
# Set STUDIO_ACCOUNTS=on to go back to per-person accounts: the login and
# sign-up screens return and each account sees only its own library. No data is
# lost either way.
# STUDIO_ACCOUNTS=on
#
# Accounts live in the studio database (.data/db.json). Passwords are stored as
# salted scrypt hashes and sessions as HttpOnly cookies, so there is no session
# secret for you to set here. Google sign-in and email are optional extras (see
# the sections below); without them, accounts work entirely on this server.
#
# The FIRST account created becomes the owner and adopts any projects that were
# saved before accounts existed. Create it at /signup the first time you open
# the studio, then choose your roles (artist / producer / engineer / promoter).
#
# Set this to false to close public sign-up on an exposed deployment. The first
# account can still be created, and existing accounts keep working.
ALLOW_SIGNUP=true

# ---------------------------------------------------------------------------
# Studio admin
# ---------------------------------------------------------------------------
# The ONE address that always has admin rights (all accounts, all projects,
# moderation). Rights are derived from this value on every request, never from a
# stored flag, so nobody can promote themselves to admin.
#
# The admin signs in with Google. Until Google is configured the studio prints a
# one-time bootstrap code in the server log at start-up; enter it at
# /admin-bootstrap. Nothing about the admin password lives in this repository.
ADMIN_EMAIL=

# Optional: fix the bootstrap code instead of using the random one. Single use,
# 24-hour expiry, ignored once Google is configured. Use 12+ random characters.
ADMIN_BOOTSTRAP_CODE=

# Optional: a setup PASSWORD for the admin account (8+ characters). It lets the
# admin sign in at /login with ADMIN_EMAIL + this password, which keeps working
# across restarts — handy while Google is not configured and a one-time code has
# already been used. It only seeds the stored scrypt hash: change the password in
# My account afterwards and this value stops mattering.
# Keep it in .env.local (git-ignored). Never commit a real password.
ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Continue with Google (OAuth 2.0)
# ---------------------------------------------------------------------------
# Create an OAuth client in Google Cloud Console → APIs & Services → Credentials
# (type: Web application). Add this exact authorised redirect URI:
#   http://localhost:3000/api/auth/google/callback        (laptop)
#   https://your-domain.com/api/auth/google/callback      (deployed)
#   https://<preview-address>/api/auth/google/callback    (a hosted preview)
# The sign-in screen prints the exact value to copy: click "Continue with
# Google" before configuring it and the set-up panel shows this address.
# Leave both empty and the sign-in screen shows "awaiting configuration"; no
# button pretends to work.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: pin the redirect URI if it differs from NEXT_PUBLIC_SITE_URL.
GOOGLE_REDIRECT_URI=

# ---------------------------------------------------------------------------
# Email (verification links)
# ---------------------------------------------------------------------------
# Only Resend is wired up. With no key, no mail is sent and the app says so —
# verification then happens from the admin console.
#   RESEND_API_KEY=re_...          from resend.com/api-keys
#   EMAIL_FROM="Elder Mi Studio <studio@yourdomain.com>"   (domain must be verified)
RESEND_API_KEY=
EMAIL_FROM=

# Reserved: a licensed neural voice-conversion provider.
# When unset, Sam Vocal Studio's voice transformation tool stays disabled
# instead of producing a fake result.
VOICE_CONVERSION_API_URL=

# ---------------------------------------------------------------------------
# AI music generation (beats, instrumentals, songs, vocal hooks)
# ---------------------------------------------------------------------------
# These are OPTIONAL. The studio ships with no model of its own: every note of
# generated audio comes from one of the hosted providers below, billed by that
# vendor to your own account. Leave a key empty and the provider is listed in
# the UI as "Awaiting configuration" — it is never shown as working.
#
# The existing GEMINI_API_KEY above is unchanged and still only drives prompt
# improvement and mixing suggestions; it does not generate audio.
#
# Safety: paid generation is OFF until you enable it in Settings → AI music
# generation, and every request is checked against SPEND_CAP_USD.

# Google Lyria 2 (Vertex AI). Beats + instrumentals, up to 30 s.
# Either an API key, or an access token + project for a service account.
GOOGLE_API_KEY=
GOOGLE_VERTEX_ACCESS_TOKEN=
GOOGLE_VERTEX_PROJECT=
GOOGLE_VERTEX_LOCATION=us-central1
LYRIA_MODEL=lyria-002

# Stability AI Stable Audio 2. Beats + instrumentals, up to 190 s, WAV.
STABILITY_API_KEY=

# ElevenLabs Music. Full songs and vocal hooks, up to 300 s, MP3.
ELEVENLABS_API_KEY=
ELEVENLABS_MUSIC_MODEL=music_v1

# Replicate MusicGen. Beats + instrumentals, up to 120 s.
REPLICATE_API_TOKEN=
REPLICATE_MUSICGEN_MODEL=meta/musicgen

# Hard ceiling on tracked generation spend, in US dollars (0–500).
SPEND_CAP_USD=5

# Optional cost overrides, in US dollars per second of generated audio.
# Defaults reflect published list prices at the time of writing; your provider
# invoice is always authoritative. Lower these if you have a cheaper plan.
LYRIA_USD_PER_SEC=0.002
STABLE_AUDIO_USD_PER_SEC=0.0015
ELEVENLABS_USD_PER_SEC=0.01
REPLICATE_MUSICGEN_USD_PER_SEC=0.0009
