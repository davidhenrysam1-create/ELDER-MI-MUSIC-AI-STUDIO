# ---------------------------------------------------------------------------
# Elder Mi Music AI Studio — environment configuration
# Copy to .env.local (never commit real secrets).
# ---------------------------------------------------------------------------

# Optional: enables "Improve My Prompt" and AI mixing stages via Gemini.
# When empty, a deterministic local production rule engine is used and clearly
# labelled "local-heuristic" in the UI.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional: where the private JSON index and audio files live.
# Deployments need a persistent volume mounted here.
DATA_DIR=./.data

# Optional: default upload limits (can also be edited in Settings).
MAX_UPLOAD_MB=80
MAX_DURATION_SEC=720

# Optional: protect the whole studio with HTTP Basic auth (pages + API).
# Leave empty for a local, open studio. Use a long random password if exposed.
STUDIO_PASSWORD=
STUDIO_USER=studio

# Reserved: a licensed neural voice-conversion provider.
# When unset, Sam Vocal Studio's voice transformation tool stays disabled
# instead of producing a fake result.
VOICE_CONVERSION_API_URL=
